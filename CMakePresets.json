{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc",
      "displayName": "DuckEggs Windows MSVC x64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/windows-msvc",
      "cacheVariables": {
        "SCHIVA_BUILD_TESTS": "ON",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
      }
    },
    {
      "name": "linux-core",
      "displayName": "DuckEggs portable core (Linux)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/out/build/linux-core",
      "cacheVariables": {
        "SCHIVA_BUILD_TESTS": "ON",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "macos-universal",
      "displayName": "DuckEggs macOS universal (Intel + Apple Silicon)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/out/build/macos-universal",
      "cacheVariables": {
        "SCHIVA_BUILD_TESTS": "ON",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "x86_64;arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "10.15"
      }
    },
    {
      "name": "macos-intel",
      "displayName": "DuckEggs macOS Intel x86_64",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/out/build/macos-intel",
      "cacheVariables": {
        "SCHIVA_BUILD_TESTS": "ON",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "10.15"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-msvc",
      "configuration": "Debug"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-msvc",
      "configuration": "Release"
    },
    {
      "name": "linux-core",
      "configurePreset": "linux-core"
    },
    {
      "name": "macos-universal",
      "configurePreset": "macos-universal"
    },
    {
      "name": "macos-intel",
      "configurePreset": "macos-intel"
    }
  ],
  "testPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-msvc",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-msvc",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-core",
      "configurePreset": "linux-core",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-universal",
      "configurePreset": "macos-universal",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-intel",
      "configurePreset": "macos-intel",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "packagePresets": [
    {
      "name": "windows-release",
      "configurePreset": "windows-msvc",
      "configurations": [
        "Release"
      ]
    },
    {
      "name": "macos-universal",
      "configurePreset": "macos-universal",
      "generators": [
        "ZIP"
      ]
    },
    {
      "name": "macos-intel",
      "configurePreset": "macos-intel",
      "generators": [
        "ZIP"
      ]
    }
  ]
}
